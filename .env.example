# Minimum local configuration
# Gemini has no deterministic fallback. Firecrawl is required by the default
# reference-image search driver.
GEMINI_API_KEY=
FIRECRAWL_API_KEY=

# Set this to the deployed HTTPS address in production.
PUBLIC_BASE_URL=http://localhost:8787
# Optional: the private address used by Playwright for visual QA. Set this when
# the public address is protected by IAP.
RENDER_BASE_URL=

# Production ClickHouse credential
# The current local Compose stack overrides this with its unauthenticated internal
# ClickHouse setup. The production Compose file will load it from Secret Manager.
CLICKHOUSE_PASSWORD=

# All other settings use the safe defaults in src/config.ts. Override them only
# when deliberately tuning workflow limits, models, references, or rendering.
