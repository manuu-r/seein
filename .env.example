# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
DATA_ROOT=./data

# Production providers: gemini | deterministic
AI_DRIVER=gemini
GEMINI_API_KEY=
# Latest GA text/multimodal model. Separate roles remain independently overridable.
GEMINI_RESEARCH_MODEL=gemini-3.7-flash
# Latest model with Google Image Search support.
GEMINI_REFERENCE_MODEL=gemini-3.1-flash-image
GEMINI_PLANNER_MODEL=gemini-3.7-flash
GEMINI_INSPECTOR_MODEL=gemini-3.7-flash

# clickhouse | memory
CONTEXT_DRIVER=clickhouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=seein
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=

# qwen-mcp | deterministic
BLENDER_DRIVER=qwen-mcp
QWEN_MCP_COMMAND=qwen-mm-plugins-blender
QWEN_MCP_ARGS=
QWEN_MM_AUTOLAUNCH=1
BLENDER_HOST=127.0.0.1
BLENDER_PORT=9876

# playwright | placeholder
SCREENSHOT_DRIVER=playwright
PLAYWRIGHT_HEADLESS=true
# Optional; defaults to Playwright's bundled Chromium executable.
PLAYWRIGHT_EXECUTABLE_PATH=
REFERENCE_MAX_COUNT=48
REFERENCE_MAX_BYTES=8000000
WORKFLOW_MAX_OBJECTS=8
# Each iteration inspects one rendered revision. Two means one possible fix plus verification.
WORKFLOW_MAX_ITERATIONS=2
# A failed evidence audit may trigger one targeted follow-up research round.
WORKFLOW_MAX_RESEARCH_ROUNDS=2

# --- Reference images: firecrawl | gemini | none ---
# Gemini's image-search grounding returns no chunks upstream, so per-object
# reference images come from Firecrawl. Set to "none" to run without images.
REFERENCE_SEARCH_DRIVER=firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_SEARCH_URL=https://api.firecrawl.dev/v2/search
# Images retrieved per object study, and how many of those reach the planner.
REFERENCE_IMAGES_PER_OBJECT=3
PLANNER_REFERENCE_IMAGES_PER_OBJECT=2
# Drops thumbnails and sprite sheets that carry no usable detail.
REFERENCE_IMAGE_MIN_EDGE=400
