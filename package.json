{
  "name": "seein-local-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "npm run build:renderer && tsc -p tsconfig.server.json",
    "build:renderer": "vite build --config vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "demo": "npm run build --silent && node --env-file-if-exists=.env dist/server/cli.js demo",
    "migrate": "npm run build --silent && node --env-file-if-exists=.env dist/server/cli.js migrate",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "npm run build --silent && node --env-file-if-exists=.env dist/server/cli.js run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.14.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "^1.29.0",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@mozilla/readability": "^0.6.0",
    "fastify": "^5.6.0",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "three": "^0.181.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.0",
    "@types/three": "^0.181.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
